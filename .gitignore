# ==============================================================================
# .gitignore - ENE0025 Protocolos de Transporte e Roteamento (UnB)
# Configuração de proteção para publicação de material acadêmico didático
# ==============================================================================

# Diretórios locais de preparação de aulas, rascunhos e materiais brutos
aulas/
Aulas/
aulas-local/
material-aula/
materiais-aula/
materiais-brutos/
rascunhos/
privado/
private/
working/
workspace/
temp/
tmp/
export/
exports/
output/

# Materiais avaliativos e restritos (acadêmico / administrativo)
provas/
gabaritos/
notas/
frequencia/
presenca/
administrativo/
avaliacao/
avaliacoes/

# Arquivos temporários do Microsoft Office e LibreOffice
~$*.docx
~$*.pptx
~$*.xlsx
~$*.vsdx
.~lock.*#

# Backups e arquivos temporários de editores
*.bak
*.tmp
*.temp
*.autosave
*~
*.swp
*.swo

# Credenciais, segredos e variáveis de ambiente
.env
.env.*
*.key
*.pem
*.pfx
*.p12
*.cert
*.crt
id_rsa
id_ecdsa
id_ed25519

# Sistema operacional (Windows, macOS, Linux)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Ambientes de desenvolvimento e IDEs (locais)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
